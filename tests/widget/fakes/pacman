#!/usr/bin/env bash
set -euo pipefail

# Fake pacman for tests/widget/run.sh. FAKE_PACKAGE is `absent`, or the
# version `pacman -Q allesbuien` prints, unless the fake curl has since written
# another to $FAKE_STATE/package; FAKE_PACKAGE_FILES is the path both list
# forms print, bare for `pacman -Qlq allesbuien` and after the owner's name for
# `pacman -Ql allesbuien`; FAKE_QT is `absent`, or the version
# `pacman -Q qt6-declarative` prints; FAKE_PACMAN_U is `ok`, or `declined` for
# an answered-no prompt. `-U` refuses a path that is not a file, as pacman
# does. Once $FAKE_STATE/query-fails exists, `-Q allesbuien` fails while
# `-Ql` and `-Qlq` still answer.
#
# pacman answers a local query for a name with the package of that name or,
# when none is installed, with one that provides it, under that package's own
# name: `pacman -Q sh` prints `bash 5.3.20-1`. FAKE_PROVIDER, unset by default,
# is such a package, one that provides allesbuien while no package of that
# name is installed; FAKE_PACKAGE and FAKE_PACKAGE_FILES are then its version
# and files, and `-Q` and `-Ql` answer under its name. `-Qlq` names no one,
# which is why widget.sh no longer asks it. The fake answers it all the same,
# as pacman does, so that a widget.sh that went back to the quiet list would
# count a provider's binary as its own and fail the foreign-owner cases for
# that reason, rather than get no list and pass them by accident.

{
  printf '%s' "${0##*/}"
  printf ' [%s]' "$@"
  printf '\n'
} >>"$FAKE_LOG"

package=$FAKE_PACKAGE
if [[ -f $FAKE_STATE/package ]]; then
  package=$(<"$FAKE_STATE/package")
fi
owner=${FAKE_PROVIDER:-allesbuien}

not_found() {
  printf "error: package '%s' was not found\n" "$1" >&2
  exit 1
}

case "${1-} ${2-}" in
  "-Q allesbuien")
    if [[ -f $FAKE_STATE/query-fails ]]; then
      printf 'fake pacman: -Q made to fail\n' >&2
      exit 1
    fi
    if [[ $package == absent ]]; then
      not_found allesbuien
    fi
    printf '%s %s\n' "$owner" "$package"
    ;;
  "-Ql allesbuien")
    if [[ $package == absent ]]; then
      not_found allesbuien
    fi
    printf '%s /usr/\n%s /usr/bin/\n%s %s\n' "$owner" "$owner" "$owner" "$FAKE_PACKAGE_FILES"
    ;;
  "-Qlq allesbuien")
    if [[ $package == absent ]]; then
      not_found allesbuien
    fi
    printf '/usr/\n/usr/bin/\n%s\n' "$FAKE_PACKAGE_FILES"
    ;;
  "-Q qt6-declarative")
    if [[ $FAKE_QT == absent ]]; then
      not_found qt6-declarative
    fi
    printf 'qt6-declarative %s\n' "$FAKE_QT"
    ;;
  "-U "*)
    if [[ $# -ne 3 || $2 != --needed ]]; then
      printf 'fake pacman: expected -U --needed <file>, got: %s\n' "$*" >&2
      exit 2
    fi
    if [[ ! -f $3 ]]; then
      printf "error: '%s': cannot open package file\n" "$3" >&2
      exit 1
    fi
    if [[ $FAKE_PACMAN_U == declined ]]; then
      printf ':: Proceed with installation? [Y/n] n\n'
      exit 1
    fi
    printf '(1/1) installing allesbuien\n'
    ;;
  *)
    printf 'fake pacman: unexpected arguments: %s\n' "$*" >&2
    exit 2
    ;;
esac
