/target/
/pkgbuild/src/
/pkgbuild/pkg/
*.pkg.tar.*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Software-factory scratch: plans, reviews, and gate logs for one run. Ignored
# here rather than only in the checkout the factory runs in, so bin/check-gates'
# scratch copy - which reads tracked and untracked-but-not-ignored files - never
# picks up a run's artefacts.
/.factory/run/
.beads/interactions.jsonl

# The maintainer's own Factory settings: FACTORY_NAME=value lines that Factory
# reads from .factory/env, and in the main checkout exempts from its checks for
# uncommitted and ignored files. Ignored so `git add -A` cannot commit one
# person's settings as the repository's defaults, which a committed copy is.
/.factory/env

# mise's and lefthook's config files are protected paths, and a global ignore
# must not hide a local one, such as mise.local.toml or lefthook-local.yml:
# mise or lefthook would read it in Factory's worktree, where an ignored file is
# in no diff and in no status, so Factory would never see it.
!mise*.toml
!.mise*.toml
!.tool-versions
!lefthook*
!.lefthook*
