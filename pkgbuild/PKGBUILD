pkgname=allesbuien
pkgver=0.2.0
pkgrel=1
pkgdesc='Dutch weather and rain radar for Omarchy'
arch=('x86_64')
url='https://github.com/robi42/AllesBuien'
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
# core/src/notify.rs spawns notify-send, which libnotify owns; the app runs
# without it and simply never notifies.
optdepends=('libnotify: rain-soon desktop notifications')
makedepends=('rust' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/allesbuien "$pkgdir/usr/bin/allesbuien"
  install -Dm644 pkgbuild/allesbuien.desktop "$pkgdir/usr/share/applications/allesbuien.desktop"
  install -Dm644 pkgbuild/allesbuien.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/allesbuien.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/allesbuien/LICENSE"
  # The notices of the third-party code compiled into the binary: the crates',
  # in the file bin/test holds to Cargo.lock, and the Rust standard library's,
  # from the toolchain that built it.
  install -Dm644 pkgbuild/THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/allesbuien/THIRD-PARTY-LICENSES"
  install -Dm644 "$(rustc --print sysroot)/share/doc/rust/COPYRIGHT-library.html" "$pkgdir/usr/share/licenses/allesbuien/COPYRIGHT-library.html"
}
