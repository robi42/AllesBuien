pkgname=allesbuien
pkgver=0.1.0
pkgrel=1
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('rust' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/allesbuien "$pkgdir/usr/bin/allesbuien"
  install -Dm644 pkgbuild/allesbuien.desktop "$pkgdir/usr/share/applications/allesbuien.desktop"
  install -Dm644 pkgbuild/allesbuien.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/allesbuien.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/allesbuien/LICENSE"
}
