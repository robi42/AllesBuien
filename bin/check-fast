#!/usr/bin/env bash
set -euo pipefail

# Every gate in this file reads tracked text and nothing else: no build, no
# generated artefact, no network. That is the entry price for running on each
# commit through lefthook, where a gate that costs a rebuild teaches --no-verify
# and takes the formatting check down with it. Gates that need a compiled tree
# live in bin/test beside the compiler, and bin/test runs this script first so
# the cheap verdicts arrive before the twenty-minute ones.
#
# Gates report every offender they find rather than stopping at the first, so
# one run is one complete worklist.

failed=0
report() {
  printf 'FAIL %s\n' "$1" >&2
  shift
  printf '%s\n' "$@" >&2
  failed=1
}

# Module size. A Rust file past 250 pure lines - non-blank, non-comment - has
# outgrown one reviewer's working memory and is doing more than one thing. The
# fix is extracting a cohesive module with its own doc and its own tests; never
# reflowing code, joining lines, or dropping comments to get under the number.
# Comments and blank lines are free on purpose, so the budget only counts
# behaviour and can never argue against explaining it.
#
# The GUI harnesses under app/tests/ held a 350-line variant of this budget
# until allesbuien-testkit existed. The argument for it was that one GUI test
# per file left their test doubles nowhere else to live, and that was true while
# all seven carried their own copy of the same stub feed, stub radar, stub
# notifier, and fixture location. Given one home for the doubles they share, the
# largest harness fell from 295 pure lines to 164 and the exception had nothing
# left to buy. One number governs the whole tree again, which is the only way a
# budget stays arguable on its merits rather than on which directory a file is
# filed under.
echo "==> gate: module size budget"
loc_limit=250
oversized=$(git ls-files '*.rs' | while read -r source_file; do
  pure_loc=$(grep -cvE '^[[:space:]]*(//|$)' "$source_file" || true)
  if [[ "$pure_loc" -gt "$loc_limit" ]]; then
    printf '  %5s  (limit %s)  %s\n' "$pure_loc" "$loc_limit" "$source_file"
  fi
done)
[[ -z "$oversized" ]] || report "Rust files over their pure-LOC budget:" "$oversized"

# CXX-Qt name binding, layer one of three. Without #[auto_cxx_name] on an
# extern "RustQt" block, every multi-word member keeps its snake_case Rust name
# on the C++ side, QML's camelCase read finds nothing, and the app runs unbound
# with a green test suite - twice now. This is the source-shape half: counting
# occurrences cannot express the rule, because two module docs quote both
# strings verbatim. Read the file as code instead: blank and comment lines are
# invisible, attributes accumulate, and any other line resets the run. Layers
# two and three check the generated type registry in bin/check-qml-contract.
echo "==> gate: cxx-qt name binding"
# shellcheck disable=SC2016  # awk program, not a shell string: $0 is awk's line
unbound=$(git ls-files '*.rs' | xargs -r awk '
  FNR == 1 { auto = 0 }
  {
    line = $0
    sub(/^[[:space:]]+/, "", line)
    sub(/[[:space:]]+$/, "", line)
  }
  line == "" || line ~ /^\/\// { next }
  line ~ /^(unsafe[[:space:]]+)?extern[[:space:]]+"RustQt"/ {
    if (!auto) printf "  %s:%d: %s\n", FILENAME, FNR, line
    auto = 0
    next
  }
  line ~ /^#\[/ { if (line == "#[auto_cxx_name]") auto = 1; next }
  { auto = 0 }
')
[[ -z "$unbound" ]] || report 'extern "RustQt" blocks without a preceding #[auto_cxx_name]:' "$unbound"

# One GUI test per harness. A second one in the same file shares a process with
# the first, so it meets a QGuiApplication that already exists and the run dies
# with a SIGSEGV that reads like a product bug rather than a layout mistake.
# Count only the attribute: every harness reaches QGuiApplication through
# allesbuien-harness, so the type's name says nothing about how many a file
# builds.
echo "==> gate: one GUI test per harness"
crowded=$(git ls-files 'app/tests/*.rs' | while read -r harness; do
  case "$harness" in app/tests/*/*) continue ;; esac
  test_count=$(grep -c '#\[test\]' "$harness" || true)
  [[ "$test_count" -eq 1 ]] || printf '  %s has %s #[test] functions, expected 1\n' "$harness" "$test_count"
done)
[[ -z "$crowded" ]] || report 'GUI harnesses that share a process between tests:' "$crowded"

# Attribution. Buienradar's free-data terms name two visible obligations: the
# words Buienradar.nl are shown, and they link to the root domain. The GUI test
# asserts both off the rendered object, which is the real proof - and which
# costs a full build to reach. This is the belt that fails in milliseconds
# instead, on the same two literals the licence actually asks for.
echo "==> gate: attribution"
missing_attribution=$(
  grep -qF 'text: "Buienradar.nl"' app/qml/Main.qml || printf '  app/qml/Main.qml no longer shows the visible text Buienradar.nl\n'
  grep -qF '"https://www.buienradar.nl"' app/qml/Main.qml || printf '  app/qml/Main.qml no longer links to https://www.buienradar.nl\n'
  grep -qF '[Buienradar.nl](https://www.buienradar.nl)' README.md || printf '  README.md no longer carries the linked attribution\n'
)
[[ -z "$missing_attribution" ]] || report 'Buienradar attribution is incomplete:' "$missing_attribution"

# Theme.qml resolves the palette and nothing else may. Every other QML file
# binds a controller property or the SystemPalette fallback, so a colour named
# anywhere else is a value that stops following the Omarchy theme the moment
# the theme changes. Theme.qml is the one file allowed a literal, and it spends
# that allowance on the "red" error fallback. Hex and computed colours are
# refused everywhere, Theme.qml included: a fabricated palette value is the
# same defect wearing the right file name, and Qt.rgba produces a colour the
# theme never sees.
#
# The bar widget under plugin/ is read too. It is drawn inside omarchy-shell,
# whose theme it has to follow just as the window follows Omarchy's, and a
# literal there is the same defect in a file the old app/qml/*.qml glob never
# opened. Files come from the index rather than a shell glob, so a directory
# with no QML in it contributes nothing instead of a literal pattern grep
# cannot open.
#
# A file this gate cannot read is an offender, not a pass. The index can name a
# file the working tree no longer has - a deletion or a rename not yet staged -
# and a scan that skipped it would report a clean tree it never looked at, so
# each one is named up front and left out of the scans. grep's own exit status
# 1 is "no match", the answer a clean tree gives; anything above it is a read
# that failed some other way, and that is reported too rather than mistaken for
# a clean result. The scan's output runs through awk, which exits 0 on no match,
# so the pipeline's status stays grep's.
echo "==> gate: theme-owned colours"
colour_files=()
bound_files=()
unreadable_colour_files=()
while IFS= read -r qml_file; do
  if [[ ! -f $qml_file || ! -r $qml_file ]]; then
    unreadable_colour_files+=("$qml_file")
    continue
  fi
  colour_files+=("$qml_file")
  if [[ $qml_file != app/qml/Theme.qml ]]; then
    bound_files+=("$qml_file")
  fi
done < <(git ls-files 'app/qml/*.qml' 'plugin/*.qml')
colour_scan() {
  local pattern=$1 quoted_only=$2 scan_status=0
  shift 2
  [[ $# -gt 0 ]] || return 0
  grep -nHE "$pattern" "$@" | awk -v quoted_only="$quoted_only" '!quoted_only || /"/' || scan_status=$?
  if [[ $scan_status -gt 1 ]]; then
    printf '  grep exited %d scanning for %s, so this gate did not read every file\n' "$scan_status" "$pattern"
  fi
}
hardcoded=$(
  for qml_file in "${unreadable_colour_files[@]}"; do
    printf '  %s: tracked, but not readable in the working tree, so it went unscanned\n' "$qml_file"
  done
  colour_scan '"#[0-9A-Fa-f]{3,8}"' 0 "${colour_files[@]}"
  colour_scan '(Qt\.(rgba|hsla|hsva|tint|colorEqual)|\.(lighter|darker))\(' 0 "${colour_files[@]}"
  colour_scan '(^|[^[:alnum:]_])color:|property[[:space:]]+color[[:space:]]' 1 "${bound_files[@]}"
)
[[ -z "$hardcoded" ]] || report 'colours written outside Theme.qml, or QML this gate could not read:' "$hardcoded"

# Image allowlist. A blanket ban would be wrong - the basemap, the screenshot
# at the root (README image and marketplace preview), and the desktop icon are
# all ours to ship - but Buienradar's map artwork is licensed to Buienradar,
# and the cheapest way to vendor it is to drop a PNG in and forget. Name the
# three, and anything else is a question that has to be answered before it
# lands. The extension list includes avif because the plugin marketplace takes
# a root preview.avif as readily as a preview.png, and a format missing from
# the list is an image this gate never sees.
echo "==> gate: image allowlist"
tracked_images=$(git ls-files '*.png' '*.jpg' '*.jpeg' '*.gif' '*.webp' '*.avif' '*.svg' '*.ico' '*.bmp' | sort)
allowed_images=$(printf '%s\n' app/assets/basemap-nl.png preview.png pkgbuild/allesbuien.svg | sort)
mismatched=$(
  comm -13 <(printf '%s\n' "$allowed_images") <(printf '%s\n' "$tracked_images") | sed 's/^/  tracked but not on the allowlist: /'
  comm -23 <(printf '%s\n' "$allowed_images") <(printf '%s\n' "$tracked_images") | sed 's/^/  on the allowlist but no longer tracked: /'
)
[[ -z "$mismatched" ]] || report 'tracked images do not match the allowlist:' "$mismatched"

# Pinned action SHAs. A tag or branch reference lets whoever owns the action
# move it under a workflow that holds this repository's contents. actionlint
# has no opinion on the subject, so the rule needs its own line: a full
# forty-character commit plus the release tag in a comment, so the pin stays
# readable to a human deciding whether to bump it.
echo "==> gate: pinned action SHAs"
unpinned=$(grep -rnE '^\s*-?\s*uses:' .github/workflows/*.yml | grep -vE '@[0-9a-f]{40} #' | sed 's/^/  /' || true)
[[ -z "$unpinned" ]] || report 'workflow steps not pinned to a 40-character SHA with a tag comment:' "$unpinned"

# cxx family lockstep. cxx embeds its patch number in every bridge symbol
# (cxxbridge1$199$...), and cxx-gen writes the C++ half of those symbols, so
# cxx 1.0.N only links against code from cxx-gen 0.7.N. cxx-gen arrives
# transitively through cxx-qt-gen, and a Dependabot bump of cxx leaves it
# behind: nothing complains until the linker reports undefined symbols eighteen
# minutes into bin/test. The fix is `cargo update -p cxx-gen --precise 0.7.N`.
#
# Only cxx and cxx-gen are compared. cxx-build, cxxbridge-cmd, cxxbridge-flags,
# and cxxbridge-macro are =-pinned by cxx's own manifest, so cargo already holds
# them in step, and widening this gate would restate cargo's job. A crate
# missing from the lock, or locked at two versions, has no single patch number
# to compare, so that is refused as well.
echo "==> gate: cxx family lockstep"
lockstep=$(awk '
  /^name = "(cxx|cxx-gen)"$/ { crate = $3; gsub(/"/, "", crate); next }
  /^name = / { crate = ""; next }
  crate != "" && /^version = / {
    ver = $3
    gsub(/"/, "", ver)
    versions[crate] = versions[crate] (versions[crate] == "" ? "" : " and ") ver
    seen[crate]++
    crate = ""
  }
  END {
    cxx = versions["cxx"]
    gen = versions["cxx-gen"]
    if (seen["cxx"] != 1 || seen["cxx-gen"] != 1) {
      printf "  Cargo.lock: expected exactly one version of each, found cxx %s, cxx-gen %s\n", (cxx == "" ? "none" : cxx), (gen == "" ? "none" : gen)
      exit
    }
    split(cxx, cxx_parts, ".")
    split(gen, gen_parts, ".")
    if (cxx_parts[3] != gen_parts[3]) {
      printf "  Cargo.lock: cxx %s, cxx-gen %s\n", cxx, gen
    }
  }
' Cargo.lock)
[[ -z "$lockstep" ]] || report 'cxx and cxx-gen must share a patch number (cxx embeds it in every bridge symbol):' "$lockstep"

# lefthook pin. lefthook.yml's min_version is the lefthook mise.toml pins, and
# each guards the other: lower, and an older lefthook first on PATH runs the
# hook again; higher, and the pinned one refuses every commit. A bump that moves
# one and not the other is refused here, on the commit that makes it.
echo "==> gate: lefthook pin"
pinned_lefthook=$(sed -n 's/^lefthook = "\(.*\)"$/\1/p' mise.toml)
min_lefthook=$(sed -n 's/^min_version: "\(.*\)"$/\1/p' lefthook.yml)
[[ -n $pinned_lefthook && $pinned_lefthook == "$min_lefthook" ]] ||
  report "lefthook.yml's min_version is not the lefthook mise.toml pins:" \
    "  lefthook.yml: ${min_lefthook:-none}, mise.toml: ${pinned_lefthook:-none}"

# Release version. Nine files carry the version - five Cargo.toml manifests,
# five versioned workspace entries in Cargo.lock, pkgver= in the PKGBUILD, the
# Omarchy manifest, and every package filename in the README - and
# release.yml compares three of them against the tag. It does so at tag time,
# after the README has already shipped a filename that does not exist and the
# marketplace has already read a manifest that names the previous release. This
# gate holds all nine to app/Cargo.toml on every commit instead.
#
# A surface that yields no version at all is an offender reported as none, as in
# the lockstep gate above: a comparison that skips what it cannot read would
# pass the tree whose pkgver= line was deleted. A file that is missing is read
# as one that says nothing, so it lands in the same report rather than stopping
# awk. CHANGELOG.md is not a surface, because it keeps every old version on
# purpose. The input contract is the one each file already has: the package
# version is the first column-one version = in a Cargo.toml, and the manifest is
# pretty-printed with its top-level keys indented two spaces.
echo "==> gate: release version"
release_surfaces=(
  app/Cargo.toml
  core/Cargo.toml
  app/harness/Cargo.toml
  app/testkit/Cargo.toml
  assets/gen-basemap/Cargo.toml
  Cargo.lock
  pkgbuild/PKGBUILD
  manifest.json
  README.md
)
readable_surfaces=()
unreadable_surfaces=()
for surface in "${release_surfaces[@]}"; do
  if [[ -f $surface && ! -r $surface ]]; then
    # A file that exists but cannot be opened would stop awk with a fatal
    # error and no report line; naming it here keeps it in the same report as
    # a surface that is missing outright, which awk then also lists as none.
    unreadable_surfaces+=("$surface")
  elif [[ -f $surface ]]; then
    readable_surfaces+=("$surface")
  fi
done
release_scan=$(
  cat <<'AWK'
FILENAME ~ /Cargo\.toml$/ && /^version = "/ && !(FILENAME in found) {
  ver = $3
  gsub(/"/, "", ver)
  found[FILENAME] = ver
}
FILENAME == "Cargo.lock" && /^name = / {
  crate = $3
  gsub(/"/, "", crate)
  next
}
FILENAME == "Cargo.lock" && crate != "" && /^version = / {
  ver = $3
  gsub(/"/, "", ver)
  found["Cargo.lock (" crate ")"] = ver
  crate = ""
}
FILENAME == "pkgbuild/PKGBUILD" && /^pkgver=/ && !(FILENAME in found) {
  ver = $0
  sub(/^pkgver=/, "", ver)
  found[FILENAME] = ver
}
FILENAME == "manifest.json" && /^  "version":/ {
  ver = $0
  sub(/^  "version":[[:space:]]*"/, "", ver)
  sub(/".*$/, "", ver)
  found[FILENAME] = ver
}
FILENAME == "README.md" {
  rest = $0
  while (match(rest, /allesbuien-[^-[:space:]]+-[0-9]+-x86_64\.pkg\.tar\.zst/)) {
    ver = substr(rest, RSTART, RLENGTH)
    sub(/^allesbuien-/, "", ver)
    sub(/-[0-9]+-x86_64\.pkg\.tar\.zst$/, "", ver)
    readme_hits++
    readme_line[readme_hits] = FNR
    readme_ver[readme_hits] = ver
    rest = substr(rest, RSTART + RLENGTH)
  }
}
END {
  reference = found["app/Cargo.toml"]
  if (reference == "") {
    print "  app/Cargo.toml: none, so there is no version to hold the others to"
    exit
  }
  surface_count = split(surfaces, order, ",")
  for (i = 1; i <= surface_count; i++) {
    ver = found[order[i]]
    if (ver != reference) printf "  %s: %s\n", order[i], (ver == "" ? "none" : ver)
  }
  if (readme_hits == 0) print "  README.md: none"
  for (i = 1; i <= readme_hits; i++) {
    if (readme_ver[i] != reference) printf "  README.md:%d: %s\n", readme_line[i], readme_ver[i]
  }
}
AWK
)
release_labels=core/Cargo.toml,app/harness/Cargo.toml,app/testkit/Cargo.toml,assets/gen-basemap/Cargo.toml
release_labels+=",Cargo.lock (allesbuien),Cargo.lock (allesbuien-core),Cargo.lock (allesbuien-harness)"
release_labels+=",Cargo.lock (allesbuien-testkit),Cargo.lock (gen-basemap),pkgbuild/PKGBUILD,manifest.json"
version_drift=$(
  for surface in "${unreadable_surfaces[@]}"; do
    printf '  %s: tracked, but not readable in the working tree, so it went unscanned\n' "$surface"
  done
  awk -v surfaces="$release_labels" "$release_scan" "${readable_surfaces[@]}" /dev/null
)
[[ -z "$version_drift" ]] || report 'version surfaces that disagree with app/Cargo.toml (README.md Releasing lists all nine):' "$version_drift"

# Omarchy plugin. omarchy-plugin-validate is what `omarchy plugin add` and the
# marketplace run, and it needs jq and an Omarchy desktop, neither of which CI's
# bare Arch container has - so until now nothing in bin/test looked at the
# plugin at all, and a symlink or a renamed entry point would have been found by
# whoever tried to install the release. This is the part of the validator that
# tracked text can answer: no symlink anywhere in the tree, a tracked
# manifest.json at schemaVersion 1 with the five required top-level keys, an id
# in the validator's character set, outside the reserved omarchy.* namespace
# and free of "..", every entry point relative, ".."-free and tracked, an entry
# point for each kind in the validator's table, a non-empty kinds list, and a
# barWidget.defaultSection of left, center, or right when one is given.
#
# It is a belt, not the validator. The input contract is a pretty-printed
# manifest - one key per line, top-level keys indented two spaces and their
# members four, as manifest.json is written - and JSON validity and value types
# are not checked here at all. README.md's Plugin checks section runs the real
# validator by hand, on a clean clone, before every tag.
echo "==> gate: omarchy plugin"
plugin_scan=$(
  cat <<'AWK'
BEGIN {
  tracked_count = split(tracked_list, paths, "\n")
  for (i = 1; i <= tracked_count; i++) tracked[paths[i]] = 1
  entry_key["bar"] = "bar"
  entry_key["bar-widget"] = "barWidget"
  entry_key["menu"] = "menu"
  entry_key["overlay"] = "overlay"
  entry_key["panel"] = "panel"
  entry_key["service"] = "service"
}
/^  "[^"]+":/ {
  key = $0
  sub(/^  "/, "", key)
  sub(/".*$/, "", key)
  top[key] = 1
  value = $0
  sub(/^  "[^"]+":[[:space:]]*/, "", value)
  sub(/,$/, "", value)
  raw[key] = value
  block = ""
  if (value == "[" || value == "{") block = key
  if (key == "kinds" && value ~ /^\[.*\]$/) {
    gsub(/[][" ]/, "", value)
    kind_count = split(value, inline_kinds, ",")
    for (i = 1; i <= kind_count; i++) if (inline_kinds[i] != "") kinds[inline_kinds[i]] = ++kinds_seen
  }
  next
}
/^  []}],?$/ { block = ""; next }
block == "kinds" {
  value = $0
  gsub(/["[:space:]]/, "", value)
  kind_count = split(value, line_kinds, ",")
  for (i = 1; i <= kind_count; i++) if (line_kinds[i] != "") kinds[line_kinds[i]] = ++kinds_seen
  next
}
block == "entryPoints" && /^    "[^"]+":/ {
  key = $0
  sub(/^    "/, "", key)
  sub(/".*$/, "", key)
  value = $0
  sub(/^    "[^"]+":[[:space:]]*"/, "", value)
  sub(/",?$/, "", value)
  entry[key] = value
  next
}
block == "barWidget" && /^    "defaultSection":/ {
  value = $0
  sub(/^    "defaultSection":[[:space:]]*/, "", value)
  sub(/,$/, "", value)
  if (value !~ /^"(left|center|right)"$/) printf "  manifest.json: barWidget.defaultSection is %s, not left, center, or right\n", value
}
END {
  if (raw["schemaVersion"] != "1") printf "  manifest.json: schemaVersion is %s, expected 1\n", (raw["schemaVersion"] == "" ? "none" : raw["schemaVersion"])
  split("id name version kinds entryPoints", required, " ")
  for (i = 1; i <= 5; i++) if (!(required[i] in top)) printf "  manifest.json: no top-level \"%s\"\n", required[i]
  id = raw["id"]
  gsub(/"/, "", id)
  if (id !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) printf "  manifest.json: id \"%s\" is empty or not [A-Za-z0-9][A-Za-z0-9._-]*\n", id
  if (id ~ /^omarchy\./) printf "  manifest.json: id %s is in the reserved omarchy.* namespace\n", id
  if (id ~ /\.\./) printf "  manifest.json: id %s contains \"..\"\n", id
  if (("kinds" in top) && kinds_seen == 0) print "  manifest.json: kinds is empty"
  for (key in entry) {
    value = entry[key]
    if (value == "") printf "  manifest.json: entryPoints.%s is empty\n", key
    else if (value ~ /^\//) printf "  manifest.json: entryPoints.%s is absolute: %s\n", key, value
    else if (value ~ /\.\./) printf "  manifest.json: entryPoints.%s contains \"..\": %s\n", key, value
    else if (!(value in tracked)) printf "  manifest.json: entryPoints.%s names %s, which is not a tracked file\n", key, value
  }
  for (kind in kinds) {
    if ((kind in entry_key) && !(entry_key[kind] in entry)) printf "  manifest.json: kind %s needs an entryPoints.%s to load\n", kind, entry_key[kind]
  }
}
AWK
)
plugin_problems=$(
  git ls-files -s | awk -F '\t' '$1 ~ /^120000 / { printf "  %s: a symlink, and omarchy plugin add refuses a tree holding one\n", $2 }'
  if [[ -f manifest.json && -n $(git ls-files -- manifest.json) ]]; then
    awk -v tracked_list="$(git ls-files)" "$plugin_scan" manifest.json
  else
    printf '  manifest.json: not tracked, so the plugin has no manifest to install from\n'
  fi
)
[[ -z "$plugin_problems" ]] || report 'the Omarchy plugin would not pass omarchy-plugin-validate:' "$plugin_problems"

# Side-effect seams. Dependency inversion in this tree has a concrete shape:
# processes, environment reads, HTTP clients, and the Tokio runtime are each
# built only in the files named for it, behind FeedApi, RadarApi, IconSource,
# Notifier, EnvSource, or a construction seam, and nothing holds process-global
# mutable state but the image provider's frame store, which Qt's C++ trampoline
# gives no other way to reach. A second reqwest client in a controller compiles,
# passes every test that injects a fake, and quietly stops being injectable.
# This gate names each constructor and the files allowed to call it.
#
# It is a belt over the spellings this tree uses, not a proof of injection: a
# plain `static X: T` whose interior mutability hides inside T gets through, as
# does a constructor reached under a re-export. Scope is production source only
# - files under a src/ directory - because build scripts have to read the
# environment and harness fakes build failing HTTP clients on purpose; a
# #[cfg(test)] block inside a scanned file is skipped for the same reason.
# Rules read the trimmed line, so a static in an inline module is as visible as
# one at column zero.
#
# Rows are `extended regex<TAB>allowed files`. The regex travels through awk -v,
# which unescapes backslashes, so every literal parenthesis is a bracket class.
echo "==> gate: side-effect seams"
seam_rules=(
  $'Command::new[(]\tcore/src/notify.rs'
  $'env::var\tcore/src/config.rs app/src/lib.rs'
  $'reqwest::Client::(new|builder)[(]\tcore/src/weather.rs core/src/radar_transport.rs app/src/icon_cache.rs'
  $'new_(multi|current)_thread[(]\tapp/src/services.rs'
  $'^(pub([(][a-z]+[)])?[[:space:]]+)?static[[:space:]]+(mut[[:space:]]|[A-Z0-9_]+:[[:space:]]*([a-z_]+::)*(OnceLock|LazyLock|Mutex|RwLock|Atomic|RefCell|Cell))\tapp/src/image_provider.rs'
  $'thread_local!\tapp/src/image_provider.rs'
)
seam_scan=$(
  cat <<'AWK'
BEGIN {
  split(allowed, names, " ")
  for (i in names) ok[names[i]] = 1
}
FNR == 1 { skip = 0; pending = 0 }
{
  line = $0
  sub(/^[[:space:]]+/, "", line)
  sub(/[[:space:]]+$/, "", line)
}
line ~ /^\/\// { next }
skip {
  if ($0 == closer) skip = 0
  next
}
line == "#[cfg(test)]" {
  pending = 1
  indent = $0
  sub(/[^[:space:]].*$/, "", indent)
  next
}
pending && line ~ /^#\[/ { next }
pending {
  pending = 0
  if (line ~ /\{$/) {
    skip = 1
    closer = indent "}"
    next
  }
}
line ~ pat && !(FILENAME in ok) { printf "  %s:%d: %s\n", FILENAME, FNR, line }
AWK
)
misplaced_effects=$(for rule in "${seam_rules[@]}"; do
  git ls-files '*/src/*.rs' | xargs -r awk -v pat="${rule%%$'\t'*}" -v allowed="${rule#*$'\t'}" "$seam_scan"
done)
[[ -z "$misplaced_effects" ]] || report 'side effects outside the files named for them (see the table in this gate):' "$misplaced_effects"

# Trait surface. Interface segregation, measured the cheap way: every trait in
# this tree has one or two methods, because each one is a seam a test fakes,
# and a fake that has to stub five methods to exercise one is the smell of a
# trait doing more than one job. Required and default methods count alike -
# a default still widens what an implementor has to reason about. The input
# contract is rustfmt output, which the formatting gate enforces: a trait's
# closing brace sits alone at the trait's own indentation, and its methods sit
# exactly one level inside it - so a helper fn declared in a default method's
# body is deeper and is not surface.
echo "==> gate: trait surface"
trait_limit=4
trait_scan=$(
  cat <<'AWK'
FNR == 1 { open = 0 }
!open && $0 ~ /^[[:space:]]*(pub([(][a-z]+[)])?[[:space:]]+)?trait[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/ && $0 !~ /[};][[:space:]]*$/ {
  open = 1
  start = FNR
  count = 0
  indent = $0
  sub(/[^[:space:]].*$/, "", indent)
  name = $0
  sub(/^[[:space:]]*(pub([(][a-z]+[)])?[[:space:]]+)?trait[[:space:]]+/, "", name)
  sub(/[^A-Za-z0-9_].*$/, "", name)
  member = "^" indent "    (pub([(][a-z]+[)])?[[:space:]]+)?(async[[:space:]]+)?(unsafe[[:space:]]+)?fn[[:space:]]"
  next
}
!open { next }
$0 == indent "}" {
  open = 0
  if (count > limit) printf "  %s:%d: trait %s has %d methods (limit %d)\n", FILENAME, start, name, count, limit
  next
}
$0 ~ member { count++ }
AWK
)
fat_traits=$(git ls-files '*.rs' | xargs -r awk -v limit="$trait_limit" "$trait_scan")
[[ -z "$fat_traits" ]] || report 'traits wider than one seam:' "$fat_traits"

# Gate coverage. bin/check-gates says how many gates it proved by counting the
# ones its fixtures named, so a gate that ships without a fixture is not merely
# unproven, it is invisible: the summary keeps printing the same totals, every
# fixture still passes, and nothing anywhere goes red. That is how a decoration
# reached this tree once already, and the arithmetic that catches it cannot live
# in bin/check-gates - that script takes a selector argument which makes its
# gate list legitimately partial, and a fixture aimed at a gate inside it would
# nest the whole fixture suite in itself. It lives here, where lefthook runs it
# on the commit that would introduce the unproven gate.
#
# A gate is declared by a column-1 `echo "==> gate: ..."` line, the same shape
# bin/check-gates' slicer matches, so what counts as a gate header has one
# definition and a comment quoting one is invisible to both. A gate is covered
# by a `gate="..."` line in a fixture. Whatever is left has to be named in
# tests/gates/uncovered with the reason it is excused, and that file is read in
# both directions so it cannot fill with names that assert nothing.
#
# Fixtures are read off the directory rather than out of the git index: the
# fixture that covers a new gate is written in the same commit and is not staged
# yet when the hook runs, and refusing the commit that closes the gap would be
# the wrong answer. bin/check-gates' own gate is outside the scan for the reason
# above, and is proven instead by every fixture it runs.
echo "==> gate: gate coverage"
declared_gates=$(awk '
  index($0, "echo \"==> gate: ") == 1 {
    sub(/^echo "==> gate: /, "")
    sub(/".*$/, "")
    print
  }
' bin/test bin/check-fast bin/check-qml-contract bin/check-worktree-hook | sort -u)
covered_gates=$(awk '
  index($0, "gate=\"") == 1 {
    sub(/^gate="/, "")
    sub(/".*$/, "")
    print
  }
' tests/gates/*.sh | sort -u)
excused_gates=$(grep -vE '^[[:space:]]*(#|$)' tests/gates/uncovered | sort -u || true)

# printf of an empty variable is one blank line rather than none, and comm would
# read that blank as a gate named "", so every set is filtered on the way in.
# One report call, because a gate that prints two headlines reads as two gates.
unproven_gates=$(
  comm -23 \
    <(printf '%s\n' "$declared_gates" | grep -v '^$') \
    <(printf '%s\n' "$covered_gates" "$excused_gates" | grep -v '^$' | sort -u) |
    sed 's|^|  no fixture, and not named in tests/gates/uncovered: |'
  comm -13 \
    <(printf '%s\n' "$declared_gates" | grep -v '^$') \
    <(printf '%s\n' "$excused_gates" | grep -v '^$') |
    sed 's|^|  named in tests/gates/uncovered, but no script declares it: |'
  comm -12 \
    <(printf '%s\n' "$covered_gates" | grep -v '^$') \
    <(printf '%s\n' "$excused_gates" | grep -v '^$') |
    sed 's|^|  named in tests/gates/uncovered, but a fixture now covers it: |'
)
[[ -z "$unproven_gates" ]] || report 'gates and their fixtures disagree:' "$unproven_gates"

exit "$failed"
