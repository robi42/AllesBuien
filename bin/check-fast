#!/usr/bin/env bash
set -euo pipefail

# Every gate in this file reads tracked text and nothing else: no build, no
# generated artefact, no network. That is the entry price for running on each
# commit through lefthook, where a gate that costs a rebuild teaches --no-verify
# and takes the formatting check down with it. Gates that need a compiled tree
# live in bin/test beside the compiler, and bin/test runs this script first so
# the cheap verdicts arrive before the twenty-minute ones.
#
# Gates report every offender they find rather than stopping at the first, so
# one run is one complete worklist.

failed=0
report() {
  printf 'FAIL %s\n' "$1" >&2
  shift
  printf '%s\n' "$@" >&2
  failed=1
}

# Module size. A Rust file past 250 pure lines - non-blank, non-comment - has
# outgrown one reviewer's working memory and is doing more than one thing. The
# fix is extracting a cohesive module with its own doc and its own tests; never
# reflowing code, joining lines, or dropping comments to get under the number.
# Comments and blank lines are free on purpose, so the budget only counts
# behaviour and can never argue against explaining it.
#
# The GUI harnesses under app/tests/ held a 350-line variant of this budget
# until allesbuien-testkit existed. The argument for it was that one GUI test
# per file left their test doubles nowhere else to live, and that was true while
# all seven carried their own copy of the same stub feed, stub radar, stub
# notifier, and fixture location. Given one home for the doubles they share, the
# largest harness fell from 295 pure lines to 164 and the exception had nothing
# left to buy. One number governs the whole tree again, which is the only way a
# budget stays arguable on its merits rather than on which directory a file is
# filed under.
echo "==> gate: module size budget"
loc_limit=250
oversized=$(git ls-files '*.rs' | while read -r source_file; do
  pure_loc=$(grep -cvE '^[[:space:]]*(//|$)' "$source_file" || true)
  if [[ "$pure_loc" -gt "$loc_limit" ]]; then
    printf '  %5s  (limit %s)  %s\n' "$pure_loc" "$loc_limit" "$source_file"
  fi
done)
[[ -z "$oversized" ]] || report "Rust files over their pure-LOC budget:" "$oversized"

# CXX-Qt name binding, layer one of three. Without #[auto_cxx_name] on an
# extern "RustQt" block, every multi-word member keeps its snake_case Rust name
# on the C++ side, QML's camelCase read finds nothing, and the app runs unbound
# with a green test suite - twice now. This is the source-shape half: counting
# occurrences cannot express the rule, because two module docs quote both
# strings verbatim. Read the file as code instead: blank and comment lines are
# invisible, attributes accumulate, and any other line resets the run. Layers
# two and three check the generated type registry in bin/check-qml-contract.
echo "==> gate: cxx-qt name binding"
# shellcheck disable=SC2016  # awk program, not a shell string: $0 is awk's line
unbound=$(git ls-files '*.rs' | xargs -r awk '
  FNR == 1 { auto = 0 }
  {
    line = $0
    sub(/^[[:space:]]+/, "", line)
    sub(/[[:space:]]+$/, "", line)
  }
  line == "" || line ~ /^\/\// { next }
  line ~ /^(unsafe[[:space:]]+)?extern[[:space:]]+"RustQt"/ {
    if (!auto) printf "  %s:%d: %s\n", FILENAME, FNR, line
    auto = 0
    next
  }
  line ~ /^#\[/ { if (line == "#[auto_cxx_name]") auto = 1; next }
  { auto = 0 }
')
[[ -z "$unbound" ]] || report 'extern "RustQt" blocks without a preceding #[auto_cxx_name]:' "$unbound"

# One GUI test per harness. A second one in the same file shares a process with
# the first, so it meets a QGuiApplication that already exists and the run dies
# with a SIGSEGV that reads like a product bug rather than a layout mistake.
# Count only the attribute: five of the seven harnesses reach QGuiApplication
# through AppBuilder::boot, so grepping for the type scores every file zero.
echo "==> gate: one GUI test per harness"
crowded=$(git ls-files 'app/tests/*.rs' | while read -r harness; do
  case "$harness" in app/tests/*/*) continue ;; esac
  test_count=$(grep -c '#\[test\]' "$harness" || true)
  [[ "$test_count" -eq 1 ]] || printf '  %s has %s #[test] functions, expected 1\n' "$harness" "$test_count"
done)
[[ -z "$crowded" ]] || report 'GUI harnesses that share a process between tests:' "$crowded"

# Attribution. Buienradar's free-data terms name two visible obligations: the
# words Buienradar.nl are shown, and they link to the root domain. The GUI test
# asserts both off the rendered object, which is the real proof - and which
# costs a full build to reach. This is the belt that fails in milliseconds
# instead, on the same two literals the licence actually asks for.
echo "==> gate: attribution"
missing_attribution=$(
  grep -qF 'text: "Buienradar.nl"' app/qml/Main.qml || printf '  app/qml/Main.qml no longer shows the visible text Buienradar.nl\n'
  grep -qF '"https://www.buienradar.nl"' app/qml/Main.qml || printf '  app/qml/Main.qml no longer links to https://www.buienradar.nl\n'
  grep -qF '[Buienradar.nl](https://www.buienradar.nl)' README.md || printf '  README.md no longer carries the linked attribution\n'
)
[[ -z "$missing_attribution" ]] || report 'Buienradar attribution is incomplete:' "$missing_attribution"

# Theme.qml resolves the palette and nothing else may. Every other QML file
# binds a controller property or the SystemPalette fallback, so a colour named
# anywhere else is a value that stops following the Omarchy theme the moment
# the theme changes. Theme.qml is the one file allowed a literal, and it spends
# that allowance on the "red" error fallback. Hex and computed colours are
# refused everywhere, Theme.qml included: a fabricated palette value is the
# same defect wearing the right file name, and Qt.rgba produces a colour the
# theme never sees.
echo "==> gate: theme-owned colours"
hardcoded=$(
  grep -nE '"#[0-9A-Fa-f]{3,8}"' app/qml/*.qml || true
  grep -nE '(Qt\.(rgba|hsla|hsva|tint|colorEqual)|\.(lighter|darker))\(' app/qml/*.qml || true
  git ls-files 'app/qml/*.qml' | grep -v '^app/qml/Theme\.qml$' | xargs -r \
    grep -nE '(^|[^[:alnum:]_])color:|property[[:space:]]+color[[:space:]]' |
    grep '"' || true
)
[[ -z "$hardcoded" ]] || report 'colours written outside Theme.qml:' "$hardcoded"

# Image allowlist. A blanket ban would be wrong - the basemap, the README
# screenshot, and the desktop icon are all ours to ship - but Buienradar's map
# artwork is licensed to Buienradar, and the cheapest way to vendor it is to
# drop a PNG in and forget. Name the three, and anything else is a question
# that has to be answered before it lands.
echo "==> gate: image allowlist"
tracked_images=$(git ls-files '*.png' '*.jpg' '*.jpeg' '*.gif' '*.webp' '*.svg' '*.ico' '*.bmp' | sort)
allowed_images=$(printf '%s\n' app/assets/basemap-nl.png assets/screenshot.png pkgbuild/allesbuien.svg | sort)
mismatched=$(
  comm -13 <(printf '%s\n' "$allowed_images") <(printf '%s\n' "$tracked_images") | sed 's/^/  tracked but not on the allowlist: /'
  comm -23 <(printf '%s\n' "$allowed_images") <(printf '%s\n' "$tracked_images") | sed 's/^/  on the allowlist but no longer tracked: /'
)
[[ -z "$mismatched" ]] || report 'tracked images do not match the allowlist:' "$mismatched"

# Pinned action SHAs. A tag or branch reference lets whoever owns the action
# move it under a workflow that holds this repository's contents. actionlint
# has no opinion on the subject, so the rule needs its own line: a full
# forty-character commit plus the release tag in a comment, so the pin stays
# readable to a human deciding whether to bump it.
echo "==> gate: pinned action SHAs"
unpinned=$(grep -rnE '^\s*-?\s*uses:' .github/workflows/*.yml | grep -vE '@[0-9a-f]{40} #' | sed 's/^/  /' || true)
[[ -z "$unpinned" ]] || report 'workflow steps not pinned to a 40-character SHA with a tag comment:' "$unpinned"

# Side-effect seams. Dependency inversion in this tree has a concrete shape:
# processes, environment reads, HTTP clients, and the Tokio runtime are each
# built in one named home behind FeedApi, RadarApi, Notifier, or a construction
# seam, and nothing holds process-global mutable state but the image provider's
# frame store, which Qt's C++ trampoline gives no other way to reach. A second
# reqwest client in a controller compiles, passes every test that injects a
# fake, and quietly stops being injectable. This gate names each constructor and
# the one file allowed to call it.
#
# It is a belt over the spellings this tree uses, not a proof of injection: a
# plain `static X: T` whose interior mutability hides inside T gets through, as
# does a constructor reached under a re-export. Scope is production source only
# - files under a src/ directory - because build scripts have to read the
# environment and harness fakes build failing HTTP clients on purpose; a
# #[cfg(test)] block inside a scanned file is skipped for the same reason.
#
# Rows are `extended regex<TAB>allowed files`. The regex travels through awk -v,
# which unescapes backslashes, so every literal parenthesis is a bracket class.
echo "==> gate: side-effect seams"
seam_rules=(
  $'Command::new[(]\tcore/src/notify.rs'
  $'env::var\tcore/src/config.rs app/src/lib.rs'
  $'reqwest::Client::(new|builder)[(]\tcore/src/weather.rs core/src/radar_transport.rs app/src/icon_cache.rs'
  $'new_(multi|current)_thread[(]\tapp/src/services.rs'
  $'^(pub([(][a-z]+[)])?[[:space:]]+)?static[[:space:]]+(mut[[:space:]]|[A-Z0-9_]+:[[:space:]]*([a-z_]+::)*(OnceLock|LazyLock|Mutex|RwLock|Atomic|RefCell|Cell))\tapp/src/image_provider.rs'
  $'thread_local!\tapp/src/image_provider.rs'
)
seam_scan=$(
  cat <<'AWK'
BEGIN {
  split(allowed, names, " ")
  for (i in names) ok[names[i]] = 1
}
FNR == 1 { skip = 0; pending = 0 }
{
  line = $0
  sub(/^[[:space:]]+/, "", line)
  sub(/[[:space:]]+$/, "", line)
}
line ~ /^\/\// { next }
skip {
  if ($0 == closer) skip = 0
  next
}
line == "#[cfg(test)]" {
  pending = 1
  indent = $0
  sub(/[^[:space:]].*$/, "", indent)
  next
}
pending && line ~ /^#\[/ { next }
pending {
  pending = 0
  if (line ~ /\{$/) {
    skip = 1
    closer = indent "}"
    next
  }
}
$0 ~ pat && !(FILENAME in ok) { printf "  %s:%d: %s\n", FILENAME, FNR, line }
AWK
)
misplaced_effects=$(for rule in "${seam_rules[@]}"; do
  git ls-files '*/src/*.rs' | xargs -r awk -v pat="${rule%%$'\t'*}" -v allowed="${rule#*$'\t'}" "$seam_scan"
done)
[[ -z "$misplaced_effects" ]] || report 'side effects outside their one home (see the table in this gate):' "$misplaced_effects"

# Trait surface. Interface segregation, measured the cheap way: every trait in
# this tree has one or two methods, because each one is a seam a test fakes,
# and a fake that has to stub five methods to exercise one is the smell of a
# trait doing more than one job. Required and default methods count alike -
# a default still widens what an implementor has to reason about. The input
# contract is rustfmt output, which the formatting gate enforces: a trait's
# closing brace sits alone at the trait's own indentation.
echo "==> gate: trait surface"
trait_limit=4
trait_scan=$(
  cat <<'AWK'
FNR == 1 { open = 0 }
!open && $0 ~ /^[[:space:]]*(pub([(][a-z]+[)])?[[:space:]]+)?trait[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/ && $0 !~ /[};][[:space:]]*$/ {
  open = 1
  start = FNR
  count = 0
  indent = $0
  sub(/[^[:space:]].*$/, "", indent)
  name = $0
  sub(/^[[:space:]]*(pub([(][a-z]+[)])?[[:space:]]+)?trait[[:space:]]+/, "", name)
  sub(/[^A-Za-z0-9_].*$/, "", name)
  next
}
!open { next }
$0 == indent "}" {
  open = 0
  if (count > limit) printf "  %s:%d: trait %s has %d methods (limit %d)\n", FILENAME, start, name, count, limit
  next
}
$0 ~ /^[[:space:]]*(pub([(][a-z]+[)])?[[:space:]]+)?(async[[:space:]]+)?(unsafe[[:space:]]+)?fn[[:space:]]/ { count++ }
AWK
)
fat_traits=$(git ls-files '*.rs' | xargs -r awk -v limit="$trait_limit" "$trait_scan")
[[ -z "$fat_traits" ]] || report 'traits wider than one seam:' "$fat_traits"

# Gate coverage. bin/check-gates says how many gates it proved by counting the
# ones its fixtures named, so a gate that ships without a fixture is not merely
# unproven, it is invisible: the summary keeps printing the same totals, every
# fixture still passes, and nothing anywhere goes red. That is how a decoration
# reached this tree once already, and the arithmetic that catches it cannot live
# in bin/check-gates - that script takes a selector argument which makes its
# gate list legitimately partial, and a fixture aimed at a gate inside it would
# nest the whole fixture suite in itself. It lives here, where lefthook runs it
# on the commit that would introduce the unproven gate.
#
# A gate is declared by a column-1 `echo "==> gate: ..."` line, the same shape
# bin/check-gates' slicer matches, so what counts as a gate header has one
# definition and a comment quoting one is invisible to both. A gate is covered
# by a `gate="..."` line in a fixture. Whatever is left has to be named in
# tests/gates/uncovered with the reason it is excused, and that file is read in
# both directions so it cannot fill with names that assert nothing.
#
# Fixtures are read off the directory rather than out of the git index: the
# fixture that covers a new gate is written in the same commit and is not staged
# yet when the hook runs, and refusing the commit that closes the gap would be
# the wrong answer. bin/check-gates' own gate is outside the scan for the reason
# above, and is proven instead by every fixture it runs.
echo "==> gate: gate coverage"
declared_gates=$(awk '
  index($0, "echo \"==> gate: ") == 1 {
    sub(/^echo "==> gate: /, "")
    sub(/".*$/, "")
    print
  }
' bin/test bin/check-fast bin/check-qml-contract | sort -u)
covered_gates=$(awk '
  index($0, "gate=\"") == 1 {
    sub(/^gate="/, "")
    sub(/".*$/, "")
    print
  }
' tests/gates/*.sh | sort -u)
excused_gates=$(grep -vE '^[[:space:]]*(#|$)' tests/gates/uncovered | sort -u || true)

# printf of an empty variable is one blank line rather than none, and comm would
# read that blank as a gate named "", so every set is filtered on the way in.
# One report call, because a gate that prints two headlines reads as two gates.
unproven_gates=$(
  comm -23 \
    <(printf '%s\n' "$declared_gates" | grep -v '^$') \
    <(printf '%s\n' "$covered_gates" "$excused_gates" | grep -v '^$' | sort -u) |
    sed 's|^|  no fixture, and not named in tests/gates/uncovered: |'
  comm -13 \
    <(printf '%s\n' "$declared_gates" | grep -v '^$') \
    <(printf '%s\n' "$excused_gates" | grep -v '^$') |
    sed 's|^|  named in tests/gates/uncovered, but no script declares it: |'
  comm -12 \
    <(printf '%s\n' "$covered_gates" | grep -v '^$') \
    <(printf '%s\n' "$excused_gates" | grep -v '^$') |
    sed 's|^|  named in tests/gates/uncovered, but a fixture now covers it: |'
)
[[ -z "$unproven_gates" ]] || report 'gates and their fixtures disagree:' "$unproven_gates"

exit "$failed"
