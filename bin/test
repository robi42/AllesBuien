#!/usr/bin/env bash
set -euo pipefail

# The workspace gate, and the one CI runs. Everything here either needs a
# compiler, a built tree, or a tool heavier than a commit should wait for; the
# millisecond text checks live in bin/check-fast and run first, so a misspelled
# attribution or an unpinned action costs a quarter of a second to learn about
# rather than twenty minutes.
#
# Gates fail loudly or not at all. A missing tool, a missing artefact, or an
# empty result set is a failure, never a skip: this repository has already lost
# one gate to a silent pass, and both name-binding regressions reached the
# desktop through suites that stayed green.

require_tool() {
  command -v "$1" >/dev/null && return 0
  printf 'error: %s is not installed. Its version is pinned in mise.toml; run: mise install\n' "$1" >&2
  exit 1
}

./bin/check-fast

# The guardrails themselves are shell, and bin/test has already shipped a shell
# bug that disabled a gate while reporting success. Linting them is not hygiene
# for its own sake; it is the only reader that checks the checkers. The
# violation fixtures under tests/gates are shell too, and they are read by the
# same argument twice over: a fixture with a quoting bug proves nothing about
# the gate it names.
echo "==> gate: shell scripts"
require_tool shellcheck
shellcheck bin/* tests/gates/*.sh

echo "==> gate: workflow syntax"
require_tool actionlint
actionlint

echo "==> gate: formatting"
cargo fmt --all --check

echo "==> gate: clippy"
cargo clippy --all-targets -- -D warnings

echo "==> gate: workspace tests"
QT_QPA_PLATFORM=offscreen cargo test --workspace

# Timezone matrix. Two modules read the host clock on purpose, and a test that
# quietly agrees with Amsterdam passes here and fails on a UTC server months
# later - twice, so far. Grepping for ::now() would only condemn the legitimate
# readers, so run the real suite in zones that disagree with this machine
# instead. TZ is not a build input, so these re-execute the binaries the gate
# above just built; Kolkata is in the list because its half-hour offset is what
# catches an assertion that pinned the minutes to :00.
echo "==> gate: timezone matrix"
for zone in UTC Asia/Kolkata Pacific/Auckland America/New_York; do
  printf '    TZ=%s\n' "$zone"
  TZ="$zone" QT_QPA_PLATFORM=offscreen cargo test --workspace --quiet
done

# Core purity. Piping into `grep -q` cannot express this safely: grep exits at
# the first match, the producer takes SIGPIPE, `pipefail` turns the pipeline's
# status into 141, and `&& exit 1` never fires while `|| true` swallows it - so
# the guard reports success precisely when it should fail. It only appeared to
# work because cargo tree's output fits the pipe buffer. Capture, then match.
echo "==> gate: core purity"
core_tree=$(cargo tree -p allesbuien-core)
if grep -qi cxx <<<"$core_tree"; then
  echo "allesbuien-core gained a CXX/Qt dependency:" >&2
  grep -in cxx <<<"$core_tree" >&2
  exit 1
fi

echo "==> gate: core coverage"
cargo llvm-cov -p allesbuien-core --fail-under-lines 85

# Capture, then match, for the reason the gate above spells out. The hazard runs
# the other way here - grep -q exits at the first match, cargo takes SIGPIPE,
# and pipefail turns an agreeing version into 141 - but it is the same shape,
# and it is the last one left in this file. Writing the fixture for this gate is
# what showed the old form also said nothing at all when it failed: its entire
# failure output was an exit code.
echo "==> gate: cargo-llvm-cov version pin"
pinned_llvm_cov=$(cat .llvm-cov-version)
installed_llvm_cov=$(cargo llvm-cov --version)
if [[ "$installed_llvm_cov" != *"$pinned_llvm_cov"* ]]; then
  printf 'error: cargo-llvm-cov reports "%s" but .llvm-cov-version pins %s\n' \
    "$installed_llvm_cov" "$pinned_llvm_cov" >&2
  exit 1
fi

# The root .qmllint.ini is committed so a Qt upgrade changes this gate's
# strictness through a reviewable diff rather than through whichever defaults
# the new release happens to ship. qmllint finds it by walking up from
# app/qml/; --max-warnings on the command line still overrides the file.
echo "==> gate: qml lint"
if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  qmllint=/usr/lib/qt6/bin/qmllint
else
  qmllint=$(command -v qmllint)
fi
"$qmllint" --max-warnings 0 -I target/cxxqt/qml_modules app/qml/*.qml

# Last two, because both read what the build registered. The workspace test gate
# above is what makes that artefact current.
./bin/check-qml-contract

# And finally the gate that checks the gates: every one above run again against
# an input it is supposed to refuse, in a throwaway copy of this tree, with the
# failure message it produces asserted rather than just its exit code. Four
# expensive gates are deliberately out of scope; tests/gates/README.md says
# which and why.
./bin/check-gates
