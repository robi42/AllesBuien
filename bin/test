#!/usr/bin/env bash
set -euo pipefail

# The workspace gate, and the one CI runs. Everything here either needs a
# compiler, a built tree, or a tool heavier than a commit should wait for; the
# millisecond text checks live in bin/check-fast and run first, so a misspelled
# attribution or an unpinned action costs a quarter of a second to learn about
# rather than twenty minutes. The two text checks here, the cargo-llvm-cov and
# cargo-about mise pins, run straight after bin/check-fast, and the first one's
# comment says why they are not part of it.
#
# Gates fail loudly or not at all. A missing tool, a missing artefact, or an
# empty result set is a failure, never a skip: this repository has already lost
# one gate to a silent pass, and both name-binding regressions reached the
# desktop through suites that stayed green. Nor does a gate quietly install
# what is missing: by default a mise shim that meets a pinned version not yet
# installed downloads it mid-run, so auto-install is off, and such a shim fails
# instead and says to run mise install.
export MISE_AUTO_INSTALL=false

require_tool() {
  command -v "$1" >/dev/null && return 0
  printf 'error: %s is not installed. Its version is pinned in mise.toml; run: mise install\n' "$1" >&2
  exit 1
}

./bin/check-fast

# cargo-llvm-cov mise pin. The cargo-llvm-cov version pin further down compares
# .llvm-cov-version with whichever cargo-llvm-cov it finds: mise.toml's pin on a
# machine mise set up, the version file's own in CI. By itself it notices the
# two files drifting apart only on such a machine, and never in CI, so this gate
# compares the files. It reads text alone, the usual mark of a bin/check-fast
# gate, and is here because bin/check-gates runs bin/check-fast in front of
# every bin/test gate it slices: there it would refuse the .llvm-cov-version
# that the version pin's fixture plants before the version pin could. Values
# print with %q, so a stray space or carriage return shows.
echo "==> gate: cargo-llvm-cov mise pin"
ci_llvm_cov=$(cat .llvm-cov-version)
mise_llvm_cov=$(sed -n 's/^"aqua:taiki-e\/cargo-llvm-cov" = "\(.*\)"$/\1/p' mise.toml)
if [[ -z $mise_llvm_cov ]]; then
  printf 'error: mise.toml has no column-one line of the shape "aqua:taiki-e/cargo-llvm-cov" = "<version>"\n' >&2
  exit 1
fi
if [[ $mise_llvm_cov != "$ci_llvm_cov" ]]; then
  printf 'error: mise.toml pins cargo-llvm-cov %q but .llvm-cov-version pins %q\n' \
    "$mise_llvm_cov" "$ci_llvm_cov" >&2
  exit 1
fi

# cargo-about mise pin, for the same reasons: the cargo-about version pin
# further down compares .cargo-about-version with whichever cargo-about it
# finds, so by itself it would notice mise.toml drifting from that file only on
# a machine mise set up, and here, rather than in bin/check-fast, it leaves the
# version pin's fixture to the version pin. It never runs cargo-about, so its
# own fixture's version, one nobody installed, never reaches a mise shim.
echo "==> gate: cargo-about mise pin"
ci_cargo_about=$(cat .cargo-about-version)
mise_cargo_about=$(sed -n 's/^"github:EmbarkStudios\/cargo-about" = "\(.*\)"$/\1/p' mise.toml)
if [[ -z $mise_cargo_about ]]; then
  printf 'error: mise.toml has no column-one line of the shape "github:EmbarkStudios/cargo-about" = "<version>"\n' >&2
  exit 1
fi
if [[ $mise_cargo_about != "$ci_cargo_about" ]]; then
  printf 'error: mise.toml pins cargo-about %q but .cargo-about-version pins %q\n' \
    "$mise_cargo_about" "$ci_cargo_about" >&2
  exit 1
fi

# The guardrails themselves are shell, and bin/test has already shipped a shell
# bug that disabled a gate while reporting success. Linting them is not hygiene
# for its own sake; it is the only reader that checks the checkers. The
# violation fixtures under tests/gates are shell too, and they are read by the
# same argument twice over: a fixture with a quoting bug proves nothing about
# the gate it names. .factory/gate is in the list for the same reason: it is the
# software factory's entrypoint into this file, so a shell bug there disables
# every gate below at once.
echo "==> gate: shell scripts"
require_tool shellcheck
shellcheck bin/* tests/gates/*.sh .factory/gate

echo "==> gate: workflow syntax"
require_tool actionlint
actionlint

# The gate scripts that run git, run as git runs a commit's hook and as git
# rebase -x runs them, in a linked worktree and in the main checkout, against a
# decoy repository they have to leave as they found it: run that way,
# bin/check-gates marked the main checkout bare until it learnt to clear git's
# variables. It builds nothing, so it sits with the checks that answer in
# seconds.
./bin/check-worktree-hook

# cargo-about writes pkgbuild/THIRD-PARTY-LICENSES, the third-party notices the
# package installs, and the third-party notices gate below regenerates that file
# and compares it byte for byte. Another release of cargo-about can word the
# same Cargo.lock differently, so the comparison means something only against
# the version CI installs. Equality rather than a substring, which would take
# 0.9.20 for 0.9.2, and captured before it is matched, for the reason the core
# purity gate below spells out.
echo "==> gate: cargo-about version pin"
require_tool cargo-about
pinned_cargo_about=$(cat .cargo-about-version)
installed_cargo_about=$(cargo about --version)
if [[ $installed_cargo_about != "cargo-about $pinned_cargo_about" ]]; then
  printf 'error: cargo-about reports "%s" but .cargo-about-version pins %s\n' \
    "$installed_cargo_about" "$pinned_cargo_about" >&2
  exit 1
fi

# Third-party notices. pkgbuild/THIRD-PARTY-LICENSES carries the notices of the
# crates the release binary is built from, and the package installs it beside
# LICENSE, so it has to say what Cargo.lock says. cargo-about writes it from the
# lock with pkgbuild/about.toml and pkgbuild/about.hbs, and it is committed
# rather than written by makepkg, so the release container needs no generator
# and a change to it is read in the pull request that causes it, Dependabot's
# included. The template prints no versions, so a bump that changes no crate and
# no licence text, the usual kind, leaves the file as it is. This regenerates
# it and refuses any difference, printing the diff and the command that fixes
# it, and --fail makes cargo-about refuse, by name, a crate whose licence
# about.toml's accepted list does not take. It needs no build, so it runs before
# the twenty minutes that do. cargo fetch comes first because the metadata
# cargo-about reads covers every target, and no build here downloads the
# Windows crates; --frozen then keeps cargo-about to the sources on disk, which
# is all it reads without workarounds or clarifications in about.toml.
echo "==> gate: third-party notices"
require_tool cargo-about
cargo fetch --locked --quiet
mkdir -p target
if ! cargo about generate --frozen --fail --manifest-path app/Cargo.toml \
  --config pkgbuild/about.toml --output-file target/THIRD-PARTY-LICENSES \
  pkgbuild/about.hbs 2>target/third-party-notices.log; then
  cat target/third-party-notices.log >&2
  printf '%s\n' \
    'error: cargo-about could not write the third-party notices. If it names a crate whose licence requirements' \
    'it cannot satisfy, pkgbuild/about.toml does not accept that licence; accepting it there is the decision to ship it.' >&2
  exit 1
fi
if ! notices_diff=$(diff -u pkgbuild/THIRD-PARTY-LICENSES target/THIRD-PARTY-LICENSES 2>&1); then
  printf '%s\n' "$notices_diff" >&2
  printf '%s\n' \
    'error: pkgbuild/THIRD-PARTY-LICENSES does not match Cargo.lock. Regenerate it, read the diff, and commit it:' \
    '  cargo fetch --locked && cargo about generate --frozen --fail -m app/Cargo.toml -c pkgbuild/about.toml -o pkgbuild/THIRD-PARTY-LICENSES pkgbuild/about.hbs' >&2
  exit 1
fi

# Third-party notice coverage. The gate above proves the committed notices are
# what cargo-about writes, and cargo-about writes what the licence files say of
# the crates about.toml lets it see. Two things get past that. A crate
# about.toml leaves out is missing from the file as well. And a notice in a
# source file's own header is one cargo-about never reads: ring's C and Rust
# files name ISC copyright holders that its licence files do not, and so do
# rustls-webpki's, and futures-channel's mpsc queue is under a two-clause BSD
# licence of its own, whose second clause asks every binary's documentation
# for its whole text. about.hbs carries those notices by hand, and this gate
# keeps them complete.
#
# It asks cargo tree, not cargo-about, which crates the binary links, and
# refuses one the file's index does not list. In each of those crates it reads
# the leading comment of every Rust, C, C++, assembly and Perl source file that
# carries an ISC, MIT or BSD-style permission notice, and refuses a copyright
# holder that comment names and no Copyright line of the notices does, and a
# BSD-style comment whose text, whitespace aside, the notices do not
# reproduce. C++ is among them because cxx, cxx-qt and cxx-qt-lib compile
# theirs into the binary. Which files a build compiles takes a build to know,
# so it reads them all but tests, benches and examples, build scripts
# included, and a notice that is not in a file's leading comment is out of
# its reach. The crates' directories come from cargo metadata, so CARGO_HOME
# is never guessed. It reads the committed file and never runs cargo-about,
# so its fixtures cost seconds.
echo "==> gate: third-party notice coverage"
notices=pkgbuild/THIRD-PARTY-LICENSES
if [[ ! -r $notices ]]; then
  printf 'error: %s is not readable, so there is no notice to compare\n' "$notices" >&2
  exit 1
fi
cargo fetch --locked --quiet
linked_tree=$(cargo tree --locked --offline -p allesbuien -e normal,no-proc-macro \
  --target x86_64-unknown-linux-gnu --prefix none --format '{p}')
# A registry crate prints as its name and version, followed by (*) where it has
# been printed before. A path crate prints its path too, and the two that
# allesbuien links are this repository's own, under LICENSE.
linked_crates=$(awk '$2 ~ /^v/ && (NF == 2 || (NF == 3 && $3 == "(*)")) { print $1, substr($2, 2) }' <<<"$linked_tree" | sort -u)
if [[ -z $linked_crates ]]; then
  printf 'error: cargo tree lists no registry crate that allesbuien links\n' >&2
  exit 1
fi
crate_metadata=$(cargo metadata --format-version 1 --locked --offline \
  --filter-platform x86_64-unknown-linux-gnu)
declare -A crate_dir=()
while IFS= read -r manifest; do
  dir=${manifest%/Cargo.toml}
  crate_dir[${dir##*/}]=$dir
done < <(grep -o '"manifest_path":"[^"]*"' <<<"$crate_metadata" | sed 's/^"manifest_path":"//; s/"$//')
indexed_crates=$(awk '
  listing && NF == 0 { exit }
  listing { print $1 }
  prev == "Crates" && /^-+$/ { listing = 1 }
  { prev = $0 }
' "$notices")
permission_notice='Permission to use, copy, modify, and(/or)? distribute this software for any|Permission is hereby granted, free of charge|Redistribution and use in source and binary forms'
# The first file is the committed notices; every other one is a source file of
# crate, whose directory is root. A file's leading comment is one /* */ block,
# or one run of lines that open with the marker its first line opens with, so
# a module's //! doc after a // header is not part of it.
coverage_scan=$(
  cat <<'AWK'
function marker(text) {
  if (text ~ /^[[:space:]]*\/\*/) return "/*"
  if (text ~ /^[[:space:]]*\/\/!/) return "//!"
  if (text ~ /^[[:space:]]*\/\/\//) return "///"
  if (text ~ /^[[:space:]]*\/\//) return "//"
  if (text ~ /^[[:space:]]*#/) return "#"
  return ""
}
function verdict(   text, name, count, list, i, seen) {
  if (!flattened) {
    gsub(/[[:space:]]+/, " ", notices)
    flattened = 1
  }
  text = header
  gsub(/[[:space:]]+/, " ", text)
  sub(/^ /, "", text)
  sub(/ $/, "", text)
  if (text !~ permission) return
  name = substr(file, length(root) + 1)
  count = split(holders, list, "\n")
  for (i = 1; i <= count; i++) {
    if (list[i] == "" || (list[i] in seen)) continue
    seen[list[i]] = 1
    if (!index(copyrights, list[i])) printf "  %s: %s names %s\n", crate, name, list[i]
  }
  if (index(text, "Redistribution and use in source and binary forms") && !index(notices, text)) {
    printf "  %s: %s has a BSD-style header whose text the notices do not reproduce\n", crate, name
  }
}
NR == FNR {
  if (index($0, "Copyright")) copyrights = copyrights $0 "\n"
  notices = notices " " $0
  next
}
FNR == 1 {
  if (file != "") verdict()
  file = FILENAME
  header = ""
  holders = ""
  state = "start"
  if ($0 ~ /^#!/) next
}
state == "done" { next }
state == "start" {
  if ($0 ~ /^[[:space:]]*$/) next
  lead = marker($0)
  if (lead == "") { state = "done"; next }
  state = lead == "/*" ? "block" : "run"
}
state == "run" && marker($0) != lead { state = "done"; next }
{
  line = $0
  closing = state == "block" && index(line, "*/")
  if (state == "block") {
    sub(/\*\/.*$/, "", line)
    sub(/^[[:space:]]*(\/\*+|\*+)/, "", line)
  } else {
    sub(/^[[:space:]]*/, "", line)
    line = substr(line, length(lead) + 1)
  }
  header = header " " line
  if (index(line, "Copyright")) {
    holder = line
    sub(/^.*Copyright[[:space:]]*/, "", holder)
    sub(/^(\([Cc]\)|©)[[:space:]]*/, "", holder)
    sub(/^[0-9][-0-9, ]*/, "", holder)
    sub(/[[:space:]]*All [Rr]ights [Rr]eserved[.]?[[:space:]]*$/, "", holder)
    sub(/[.,[:space:]]+$/, "", holder)
    if (holder != "") holders = holders holder "\n"
  }
  if (closing) state = "done"
}
END {
  if (file != "") verdict()
}
AWK
)
uncovered=$(
  while read -r crate version; do
    grep -qxF -- "$crate" <<<"$indexed_crates" ||
      printf '  %s lists no entry for %s, which allesbuien links\n' "$notices" "$crate"
    dir=${crate_dir[$crate-$version]:-}
    if [[ -z $dir ]]; then
      printf '  %s %s: cargo metadata names no source directory for it\n' "$crate" "$version"
      continue
    fi
    scan_status=0
    headed=$(grep -rlE --include='*.rs' --include='*.c' --include='*.h' --include='*.inl' \
      --include='*.cc' --include='*.cpp' --include='*.cxx' --include='*.hh' --include='*.hpp' \
      --include='*.hxx' --include='*.S' --include='*.pl' --exclude-dir=tests \
      --exclude-dir=benches --exclude-dir=examples "$permission_notice" "$dir") || scan_status=$?
    if [[ $scan_status -gt 1 ]]; then
      printf '  %s: grep exited %d reading %s, so this gate did not read every file\n' \
        "$crate" "$scan_status" "$dir"
    fi
    [[ -n $headed ]] || continue
    mapfile -t headed_files <<<"$headed"
    awk -v crate="$crate" -v root="$dir/" -v permission="$permission_notice" "$coverage_scan" \
      "$notices" "${headed_files[@]}" ||
      printf '  %s: the header scan exited %d, so this gate did not read every file\n' "$crate" "$?"
  done <<<"$linked_crates"
)
if [[ -n $uncovered ]]; then
  printf '%s\n' "error: $notices leaves out notices that code allesbuien links asks for:" "$uncovered" >&2
  printf '%s\n' \
    'A crate missing from the index is one pkgbuild/about.toml leaves out. A copyright holder, or a header whose text' \
    'the notices have to carry, goes into the hand-kept section of pkgbuild/about.hbs. Then regenerate:' \
    '  cargo fetch --locked && cargo about generate --frozen --fail -m app/Cargo.toml -c pkgbuild/about.toml -o pkgbuild/THIRD-PARTY-LICENSES pkgbuild/about.hbs' >&2
  exit 1
fi

echo "==> gate: formatting"
cargo fmt --all --check

echo "==> gate: clippy"
cargo clippy --all-targets -- -D warnings

echo "==> gate: workspace tests"
QT_QPA_PLATFORM=offscreen cargo test --workspace

# Timezone matrix. Three modules read the host clock on purpose, and a test that
# quietly agrees with Amsterdam passes here and fails on a UTC server months
# later - twice, so far. Grepping for ::now() would only condemn the legitimate
# readers, so run the real suite in zones that disagree with this machine
# instead. TZ is not a build input, so these re-execute the binaries the gate
# above just built; Kolkata is in the list because its half-hour offset is what
# catches an assertion that pinned the minutes to :00.
echo "==> gate: timezone matrix"
for zone in UTC Asia/Kolkata Pacific/Auckland America/New_York; do
  printf '    TZ=%s\n' "$zone"
  TZ="$zone" QT_QPA_PLATFORM=offscreen cargo test --workspace --quiet
done

# Core purity. Piping into `grep -q` cannot express this safely: grep exits at
# the first match, the producer takes SIGPIPE, `pipefail` turns the pipeline's
# status into 141, and `&& exit 1` never fires while `|| true` swallows it - so
# the guard reports success precisely when it should fail. It only appeared to
# work because cargo tree's output fits the pipe buffer. Capture, then match.
echo "==> gate: core purity"
core_tree=$(cargo tree -p allesbuien-core)
if grep -qi cxx <<<"$core_tree"; then
  echo "allesbuien-core gained a CXX/Qt dependency:" >&2
  grep -in cxx <<<"$core_tree" >&2
  exit 1
fi

echo "==> gate: core coverage"
cargo llvm-cov -p allesbuien-core --fail-under-lines 90

# Capture, then match, for the reason the gate above spells out. The hazard runs
# the other way here - grep -q exits at the first match, cargo takes SIGPIPE,
# and pipefail turns an agreeing version into 141 - but it is the same shape,
# and it is the last one left in this file. Writing the fixture for this gate is
# what showed the old form also said nothing at all when it failed: its entire
# failure output was an exit code.
echo "==> gate: cargo-llvm-cov version pin"
pinned_llvm_cov=$(cat .llvm-cov-version)
installed_llvm_cov=$(cargo llvm-cov --version)
if [[ "$installed_llvm_cov" != *"$pinned_llvm_cov"* ]]; then
  printf 'error: cargo-llvm-cov reports "%s" but .llvm-cov-version pins %s\n' \
    "$installed_llvm_cov" "$pinned_llvm_cov" >&2
  exit 1
fi

# The root .qmllint.ini is committed so a Qt upgrade changes this gate's
# strictness through a reviewable diff rather than through whichever defaults
# the new release happens to ship. qmllint finds it by walking up from
# app/qml/; --max-warnings on the command line still overrides the file.
echo "==> gate: qml lint"
if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  qmllint=/usr/lib/qt6/bin/qmllint
else
  qmllint=$(command -v qmllint)
fi
"$qmllint" --max-warnings 0 -I target/cxxqt/qml_modules app/qml/*.qml

# Last two, because both read what the build registered. The workspace test gate
# above is what makes that artefact current.
./bin/check-qml-contract

# And finally the gate that checks the gates: every one above run again against
# an input it is supposed to refuse, in a throwaway copy of this tree, with the
# failure message it produces asserted rather than just its exit code. Four
# expensive gates are deliberately out of scope; tests/gates/README.md says
# which and why.
./bin/check-gates
