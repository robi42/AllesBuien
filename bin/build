#!/usr/bin/env bash
set -euo pipefail

cargo_version=$(cargo --version)
grep -q '^cargo 1\.99\.1 ' <<<"$cargo_version" || {
  printf 'error: expected Cargo 1.99.1, got %s\n' "$cargo_version" >&2
  exit 1
}
printf 'cargo: %s\n' "$(command -v cargo)"

# Arch makepkg's C LTO flags produce incomplete ring archives for rust-lld.
CFLAGS=${CFLAGS:-}
CXXFLAGS=${CXXFLAGS:-}
export CFLAGS="${CFLAGS//-flto=auto/}"
export CXXFLAGS="${CXXFLAGS//-flto=auto/}"

# --locked, because the PKGBUILD's build() runs this for the release package:
# it builds the dependency versions Cargo.lock records, the ones CI tested,
# and fails where it would otherwise resolve them afresh.
cargo build --release --locked
